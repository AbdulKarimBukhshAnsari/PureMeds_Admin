server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Uploads (complaint images, medicine images) go through here
    client_max_body_size 10m;

    # Health check for the load balancer target group
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Reverse-proxy API calls to the private Application Tier.
    # Browser -> ALB -> Nginx (web tier) -> backend (app tier). The backend is never public.
    location /api/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Cache built assets (Vite adds content hashes to filenames)
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # React Router: send unknown paths to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
